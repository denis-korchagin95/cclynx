@test("It should raise an error when unsigned follows void")
@given("stdin")
int main() {
    void unsigned x;
    return 0;
}
@whenRun("./bin/cclynx", args="--emit-ast --no-warnings /dev/stdin")
@expectOutput("stderr")
{{any}}:2:10: ERROR: 'unsigned' cannot be applied to 'void'
{{any}}:2:19: ERROR: variable cannot have 'void' type

@endtest

@test("It should raise an error when signed follows void")
@given("stdin")
int main() {
    void signed x;
    return 0;
}
@whenRun("./bin/cclynx", args="--emit-ast --no-warnings /dev/stdin")
@expectOutput("stderr")
{{any}}:2:10: ERROR: 'signed' cannot be applied to 'void'
{{any}}:2:17: ERROR: variable cannot have 'void' type

@endtest

@test("It should raise an error when 'signed' and 'unsigned' are mixed in variable declaration")
@given("stdin")
int main() {
    signed unsigned x;
    return 0;
}
@whenRun("./bin/cclynx", args="--emit-ast --no-warnings /dev/stdin")
@expectOutput("stderr")
{{any}}:2:12: ERROR: 'unsigned' cannot be mixed with 'signed'

@endtest

@test("It should raise a duplicate type specifier error for 'int int'")
@given("stdin")
int int foo() {
    return 0;
}
@whenRun("./bin/cclynx", args="--emit-ast --no-warnings /dev/stdin")
@expectOutput("stderr")
{{any}}:1:5: ERROR: duplicate type specifier 'int'

@endtest

@test("It should raise a duplicate type specifier error for 'void void'")
@given("stdin")
void void foo() {
    return;
}
@whenRun("./bin/cclynx", args="--emit-ast --no-warnings /dev/stdin")
@expectOutput("stderr")
{{any}}:1:6: ERROR: duplicate type specifier 'void'

@endtest

@test("It should raise a mixed types error for 'int void'")
@given("stdin")
int void foo() {
    return 0;
}
@whenRun("./bin/cclynx", args="--emit-ast --no-warnings /dev/stdin")
@expectOutput("stderr")
{{any}}:1:5: ERROR: mixed types

@endtest

@test("It should raise a mixed types error for 'void int'")
@given("stdin")
void int foo() {
    return;
}
@whenRun("./bin/cclynx", args="--emit-ast --no-warnings /dev/stdin")
@expectOutput("stderr")
{{any}}:1:6: ERROR: mixed types

@endtest

