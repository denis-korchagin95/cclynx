@test("It should parse an implicitly signed integer variable")
@given("stdin")
int main() {
    int x;
    return 0;
}
@whenRun("./bin/cclynx", args="--emit-ast /dev/stdin")
@expectOutput("stdout")
TranslationUnit: '{{any}}'
└── FunctionDefinition: 'main' <unspecified-parameters>
    ├── ReturnType
    │   ├── category: 'basic'
    │   └── descriptor: 'int'
    └── CompoundStatement
        ├── VariableDeclaration: 'x'
        │   └── Type
        │       ├── category: 'basic'
        │       └── descriptor: 'int'
        └── JumpStatement
            ├── Operation: 'return'
            └── IntegerConstant: '0'
                └── Type
                    ├── category: 'basic'
                    └── descriptor: 'int'

@endtest

@test("It should parse an explicitly unsigned integer variable")
@given("stdin")
int main() {
    unsigned int x;
    return 0;
}
@whenRun("./bin/cclynx", args="--emit-ast /dev/stdin")
@expectOutput("stdout")
TranslationUnit: '{{any}}'
└── FunctionDefinition: 'main' <unspecified-parameters>
    ├── ReturnType
    │   ├── category: 'basic'
    │   └── descriptor: 'int'
    └── CompoundStatement
        ├── VariableDeclaration: 'x'
        │   └── Type
        │       ├── category: 'basic'
        │       └── descriptor: 'unsigned int'
        └── JumpStatement
            ├── Operation: 'return'
            └── IntegerConstant: '0'
                └── Type
                    ├── category: 'basic'
                    └── descriptor: 'int'

@endtest

@test("It should parse unsigned as an integer variable by default")
@given("stdin")
int main() {
    unsigned x;
    return 0;
}
@whenRun("./bin/cclynx", args="--emit-ast /dev/stdin")
@expectOutput("stdout")
TranslationUnit: '{{any}}'
└── FunctionDefinition: 'main' <unspecified-parameters>
    ├── ReturnType
    │   ├── category: 'basic'
    │   └── descriptor: 'int'
    └── CompoundStatement
        ├── VariableDeclaration: 'x'
        │   └── Type
        │       ├── category: 'basic'
        │       └── descriptor: 'unsigned int'
        └── JumpStatement
            ├── Operation: 'return'
            └── IntegerConstant: '0'
                └── Type
                    ├── category: 'basic'
                    └── descriptor: 'int'

@endtest

@test("It should show an error if unsigned duplicates more than one time")
@given("stdin")
int main() {
    unsigned unsigned int x;
    return 0;
}
@whenRun("./bin/cclynx", args="--emit-ast --no-warnings /dev/stdin")
@expectOutput("stderr")
{{any}}:2:14: ERROR: duplicate 'unsigned' keyword

@endtest

@test("It should raise an error when unsigned is applied to void")
@given("stdin")
unsigned void foo() {
    return;
}
@whenRun("./bin/cclynx", args="--emit-ast --no-warnings /dev/stdin")
@expectOutput("stderr")
{{any}}:1:10: ERROR: 'unsigned' cannot be applied to 'void'

@endtest

@test("It should raise an error on void variable declaration")
@given("stdin")
int main() {
    void x;
    return 0;
}
@whenRun("./bin/cclynx", args="--emit-ast --no-warnings /dev/stdin")
@expectOutput("stderr")
{{any}}:2:10: ERROR: variable cannot have 'void' type

@endtest

@test("It should parse signed as signed int by default")
@given("stdin")
int main() {
    signed x;
    return 0;
}
@whenRun("./bin/cclynx", args="--emit-ast --no-warnings /dev/stdin")
@expectOutput("stdout")
TranslationUnit: 'stdin'
└── FunctionDefinition: 'main' <unspecified-parameters>
    ├── ReturnType
