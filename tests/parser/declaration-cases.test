    │   └── descriptor: 'int'
    └── CompoundStatement
        ├── VariableDeclaration: 'x'
        │   └── Type
        │       ├── category: 'basic'
        │       └── descriptor: 'int'
        └── JumpStatement
            ├── Operation: 'return'
            └── IntegerConstant: '0'
                └── Type
                    ├── category: 'basic'
                    └── descriptor: 'int'

@endtest

@test("It should show an error if signed duplicates more than one time")
@given("stdin")
int main() {
    signed signed x;
    return 0;
}
@whenRun("./bin/cclynx", args="--emit-ast --no-warnings /dev/stdin")
@expectOutput("stderr")
{{any}}:2:12: ERROR: duplicate 'signed' keyword

@endtest

@test("It should raise an error when signed is applied to void")
@given("stdin")
signed void foo() {
    return;
}
@whenRun("./bin/cclynx", args="--emit-ast --no-warnings /dev/stdin")
@expectOutput("stderr")
{{any}}:1:8: ERROR: 'signed' cannot be applied to 'void'

@endtest

@test("It should raise an error when signed mixed with unsigned")
@given("stdin")
unsigned signed foo() {
    return;
}
@whenRun("./bin/cclynx", args="--emit-ast --no-warnings /dev/stdin")
@expectOutput("stderr")
{{any}}:1:10: ERROR: 'signed' cannot be mixed with 'unsigned'

@endtest

@test("It should raise an error when unsigned mixed with signed")
@given("stdin")
signed unsigned foo() {
    return;
}
@whenRun("./bin/cclynx", args="--emit-ast --no-warnings /dev/stdin")
@expectOutput("stderr")
{{any}}:1:8: ERROR: 'unsigned' cannot be mixed with 'signed'

@endtest

