@test("It should raise an error on argument count mismatch")
@given("stdin")
int add(int a, int b) {
    return a + b;
}

int main() {
    return add(1);
}
@whenRun("./bin/cclynx", args="--emit-ast --no-warnings /dev/stdin")
@expectOutput("stderr")
{{any}}:6:12: ERROR: function 'add' expects 2 arguments but 1 were provided

@endtest

@test("It should raise an error when function call uses a keyword as name")
@given("stdin")
int main() {
    return 42 * while();
}
@whenRun("./bin/cclynx", args="--emit-ast --no-warnings /dev/stdin")
@expectOutput("stderr")
{{any}}:2:17: ERROR: expected identifier but got keyword 'while'

@endtest

@test("It should insert implicit cast on function argument when signedness differs")
@given("stdin")
int foo(int a) {
    return a;
}

int main() {
    return foo(42u);
}
@whenRun("./bin/cclynx", args="--emit-ast --no-warnings /dev/stdin")
@expectOutput("stdout")
TranslationUnit: '{{any}}'
├── FunctionDefinition: 'foo' <1-parameter>
│   ├── ReturnType
│   │   ├── category: 'basic'
│   │   └── descriptor: 'int'
│   ├── ParameterList
│   │   └── Parameter: 'a'
│   │       └── Type
│   │           ├── category: 'basic'
│   │           └── descriptor: 'int'
│   └── CompoundStatement
│       └── ReturnStatement
│           └── VariableExpression: 'a'
│               └── Type
│                   ├── category: 'basic'
│                   └── descriptor: 'int'
└── FunctionDefinition: 'main' <unspecified-parameters>
    ├── ReturnType
    │   ├── category: 'basic'
    │   └── descriptor: 'int'
    └── CompoundStatement
        └── ReturnStatement
            └── FunctionCallExpression: 'foo' <1-argument>
                ├── ReturnType
                │   ├── category: 'basic'
                │   └── descriptor: 'int'
                └── CastExpression
                    ├── Type
                    │   ├── category: 'basic'
                    │   └── descriptor: 'int'
                    └── IntegerConstant: '42'
                        └── Type
                            ├── category: 'basic'
                            └── descriptor: 'unsigned int'

@endtest
