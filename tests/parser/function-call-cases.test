@test("It should parse function calls without parameters")
@given("stdin")
int foo(void) {
   return 7;
}

int main() {
    return 42 * foo();
}
@whenRun("./bin/cclynx", args="--emit-ast /dev/stdin")
@expectOutput("stdout")
TranslationUnit: '{{any}}'
├── FunctionDefinition: 'foo' <no-parameters>
│   ├── ReturnType
│   │   ├── category: 'basic'
│   │   └── descriptor: 'int'
│   └── CompoundStatement
│       └── ReturnStatement
│           └── IntegerConstant: '7'
│               └── Type
│                   ├── category: 'basic'
│                   └── descriptor: 'int'
└── FunctionDefinition: 'main' <unspecified-parameters>
    ├── ReturnType
    │   ├── category: 'basic'
    │   └── descriptor: 'int'
    └── CompoundStatement
        └── ReturnStatement
            └── BinaryExpression
                ├── Operation: '*'
                ├── Type
                │   ├── category: 'basic'
                │   └── descriptor: 'int'
                ├── Lhs
                │   └── IntegerConstant: '42'
                │       └── Type
                │           ├── category: 'basic'
                │           └── descriptor: 'int'
                └── Rhs
                    └── FunctionCallExpression: 'foo' <no-arguments>
                        └── ReturnType
                            ├── category: 'basic'
                            └── descriptor: 'int'

@endtest

@test("It should parse function calls with unspecified parameters")
@given("stdin")
int foo() {
   return 7;
}

int main() {
    return 42 * foo();
}
@whenRun("./bin/cclynx", args="--emit-ast /dev/stdin")
@expectOutput("stdout")
TranslationUnit: '{{any}}'
├── FunctionDefinition: 'foo' <unspecified-parameters>
