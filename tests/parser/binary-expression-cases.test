@test("It should parse a multiplicative expression (*) (primitive case)")
@given("stdin")
int main() {
    7 * 8;
}
@whenRun("./bin/cclynx", args="--emit-ast /dev/stdin")
@expectOutput("stdout")
TranslationUnit: '{{any}}'
└── FunctionDefinition: 'main' <unspecified-parameters>
    ├── ReturnType
    │   ├── category: 'basic'
    │   └── descriptor: 'int'
    └── CompoundStatement
        └── ExpressionStatement
            └── BinaryExpression
                ├── Operation: '*'
                ├── Type
                │   ├── category: 'basic'
                │   └── descriptor: 'int'
                ├── Lhs
                │   └── IntegerConstant: '7'
                │       └── Type
                │           ├── category: 'basic'
                │           └── descriptor: 'int'
                └── Rhs
                    └── IntegerConstant: '8'
                        └── Type
                            ├── category: 'basic'
                            └── descriptor: 'int'

@endtest

