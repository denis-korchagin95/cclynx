                    │       │   └── descriptor: 'unsigned int'
                    │       └── VariableExpression: 'x'
                    │           └── Type
                    │               ├── category: 'basic'
                    │               └── descriptor: 'int'
                    └── Rhs
                        └── VariableExpression: 'y'
                            └── Type
                                ├── category: 'basic'
                                └── descriptor: 'unsigned int'

@endtest

@test("It should insert implicit cast on relational expression with mixed signedness")
@given("stdin")
