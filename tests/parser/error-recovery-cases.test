@test("It should recover after missing ';' on return statement")
@given("stdin")
int main() {
    int a;
    int b;
    a = 1;
    return 1
    b = 2;
    return 0;
}
@whenRun("./bin/cclynx", args="--emit-ast --no-warnings /dev/stdin")
@expectOutput("stderr")
{{any}}:6:5: ERROR: expected ';' but got identifier 'b'

@endtest

@test("It should recover after missing ';' on break statement")
@given("stdin")
int main() {
    int x;
    while (x) {
        break
        x = 0;
    }
    return 0;
}
@whenRun("./bin/cclynx", args="--emit-ast --no-warnings /dev/stdin")
@expectOutput("stderr")
{{any}}:5:9: ERROR: expected ';' but got identifier 'x'

@endtest

@test("It should recover after missing ';' on continue statement")
@given("stdin")
int main() {
    int x;
    while (x) {
        continue
        x = 0;
    }
    return 0;
}
@whenRun("./bin/cclynx", args="--emit-ast --no-warnings /dev/stdin")
@expectOutput("stderr")
{{any}}:5:9: ERROR: expected ';' but got identifier 'x'

@endtest

@test("It should recover after missing ';' on variable declaration")
@given("stdin")
int main() {
    int a
    return 0;
}
@whenRun("./bin/cclynx", args="--emit-ast --no-warnings /dev/stdin")
@expectOutput("stderr")
{{any}}:3:5: ERROR: expected ';' but got keyword 'return'

@endtest

@test("It should recover after missing ';' on expression statement")
@given("stdin")
int main() {
    int a;
    int b;
    a = 1
    b = 2;
    return 0;
}
@whenRun("./bin/cclynx", args="--emit-ast --no-warnings /dev/stdin")
@expectOutput("stderr")
{{any}}:5:5: ERROR: expected ';' but got identifier 'b'

@endtest

@test("It should report missing '(' in if statement")
@given("stdin")
int main() {
    if x > 0) {
        return 1;
    }
    return 2;
}
@whenRun("./bin/cclynx", args="--emit-ast --no-warnings /dev/stdin")
@expectOutput("stderr")
{{any}}:2:8: ERROR: expected '(' but got identifier 'x'
{{any}}:5:5: ERROR: expected type specifier but got keyword 'return'

@endtest

@test("It should report missing ')' in if statement")
@given("stdin")
int main() {
    int x;
    if (x {
        return 1;
    }
    return 2;
}
@whenRun("./bin/cclynx", args="--emit-ast --no-warnings /dev/stdin")
@expectOutput("stderr")
{{any}}:3:11: ERROR: expected ')' but got '{'
{{any}}:6:5: ERROR: expected type specifier but got keyword 'return'

@endtest

@test("It should report missing '(' in while statement")
@given("stdin")
int main() {
    int x;
    while x) {
        x = x + 1;
    }
    return 0;
}
@whenRun("./bin/cclynx", args="--emit-ast --no-warnings /dev/stdin")
@expectOutput("stderr")
{{any}}:3:11: ERROR: expected '(' but got identifier 'x'
{{any}}:6:5: ERROR: expected type specifier but got keyword 'return'

@endtest

@test("It should report missing ')' in while statement")
@given("stdin")
int main() {
    int x;
    while (x {
        x = x + 1;
    }
    return 0;
}
@whenRun("./bin/cclynx", args="--emit-ast --no-warnings /dev/stdin")
@expectOutput("stderr")
{{any}}:3:14: ERROR: expected ')' but got '{'
{{any}}:6:5: ERROR: expected type specifier but got keyword 'return'

@endtest

@test("It should report missing '{' in function body")
@given("stdin")
int main()
    return 42;
}
@whenRun("./bin/cclynx", args="--emit-ast --no-warnings /dev/stdin")
@expectOutput("stderr")
{{any}}:2:5: ERROR: expected '{' but got keyword 'return'
{{any}}:2:5: ERROR: expected type specifier but got keyword 'return'

@endtest

@test("It should report missing '}' at end of function body")
@given("stdin")
int main() {
    return 42;
@whenRun("./bin/cclynx", args="--emit-ast --no-warnings /dev/stdin")
@expectOutput("stderr")
{{any}}:0:0: ERROR: expected '}' but got end of file

@endtest

@test("It should stringify a number token in error messages")
@given("stdin")
int main() {
    int 5;
    return 0;
}
@whenRun("./bin/cclynx", args="--emit-ast --no-warnings /dev/stdin")
@expectOutput("stderr")
{{any}}:2:9: ERROR: expected identifier but got number

@endtest

@test("It should stringify an '==' punctuator in error messages")
@given("stdin")
int main() {
    == 1;
    return 0;
}
@whenRun("./bin/cclynx", args="--emit-ast --no-warnings /dev/stdin")
@expectOutput("stderr")
{{any}}:2:5: ERROR: expected expression but got '=='

@endtest

@test("It should stringify a '!=' punctuator in error messages")
@given("stdin")
int main() {
    != 1;
    return 0;
}
@whenRun("./bin/cclynx", args="--emit-ast --no-warnings /dev/stdin")
@expectOutput("stderr")
{{any}}:2:5: ERROR: expected expression but got '!='

@endtest
