@test("It should parse while with empty statement")
@given("stdin")
int main() {
    int i;
    i = 0;
    while(i < 10);
}
@whenRun("./bin/cclynx", args="--emit-ast /dev/stdin")
@expectOutput("stdout")
TranslationUnit: '{{any}}'
└── FunctionDefinition: 'main' <unspecified-parameters>
    ├── ReturnType
    │   ├── category: 'basic'
    │   └── descriptor: 'int'
    └── CompoundStatement
        ├── VariableDeclaration: 'i'
        │   └── Type
        │       ├── category: 'basic'
        │       └── descriptor: 'int'
        ├── ExpressionStatement
        │   └── AssignmentExpression: '='
        │       ├── VariableExpression: 'i'
        │       │   └── Type
        │       │       ├── category: 'basic'
        │       │       └── descriptor: 'int'
        │       └── IntegerConstant: '0'
        │           └── Type
        │               ├── category: 'basic'
        │               └── descriptor: 'int'
        └── WhileStatement
            ├── (condition) BinaryExpression
            │   ├── Operation: '<'
            │   ├── Type
            │   │   ├── category: 'basic'
            │   │   └── descriptor: 'int'
            │   ├── Lhs
            │   │   └── VariableExpression: 'i'
            │   │       └── Type
            │   │           ├── category: 'basic'
            │   │           └── descriptor: 'int'
            │   └── Rhs
            │       └── IntegerConstant: '10'
            │           └── Type
            │               ├── category: 'basic'
            │               └── descriptor: 'int'
            └── (body) ExpressionStatement: {empty expression}

@endtest

@test("It should parse while with simple expression")
@given("stdin")
int main() {
    int i;
    i = 0;
    while(i < 10)
        i = i + 1;
}
