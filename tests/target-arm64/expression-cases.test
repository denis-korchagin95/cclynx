@test("It should generate target arm64 code for additive and multiplicative expression (+, *)")
@given("stdin")
int main() {
    return 2 * 3 + 1;
}
@whenRun("./bin/cclynx", args="--emit-asm /dev/stdin")
@expectOutput("stdout")
.text
.align 2

.global _main
_main:
    stp x29, x30, [sp, -16]!
    mov x29, sp
    mov w9, #2
    mov w10, #3
    mul w11, w9, w10
    mov w9, #1
    add w10, w11, w9
    mov w0, w10
    ldp x29, x30, [sp], #16
    ret

@endtest

@test("It should generate target arm64 code for nested sub-expressions")
@given("stdin")
int main() {
    return 2 * ((3 * 4 + 20) + 1) * 15;
}
@whenRun("./bin/cclynx", args="--emit-asm /dev/stdin")
@expectOutput("stdout")
.text
.align 2

.global _main
_main:
    stp x29, x30, [sp, -16]!
    mov x29, sp
    mov w9, #2
    mov w10, #3
    mov w11, #4
    mul w12, w10, w11
    mov w10, #20
    add w11, w12, w10
    mov w10, #1
    add w12, w11, w10
    mul w10, w9, w12
    mov w9, #15
    mul w11, w10, w9
    mov w0, w11
    ldp x29, x30, [sp], #16
    ret

@endtest

@test("It should generate target arm64 code for subtraction and division (-, /)")
@given("stdin")
int main() {
    return 12 / 3 - 1;
}
@whenRun("./bin/cclynx", args="--emit-asm /dev/stdin")
@expectOutput("stdout")
.text
.align 2

.global _main
_main:
    stp x29, x30, [sp, -16]!
    mov x29, sp
    mov w9, #12
    mov w10, #3
    sdiv w11, w9, w10
    mov w9, #1
    sub w10, w11, w9
    mov w0, w10
    ldp x29, x30, [sp], #16
    ret

@endtest

@test("It should generate target arm64 code for signed greater than (>)")
@given("stdin")
int main() {
    return 12 > 3;
}
@whenRun("./bin/cclynx", args="--emit-asm /dev/stdin")
@expectOutput("stdout")
.text
.align 2

.global _main
_main:
    stp x29, x30, [sp, -16]!
    mov x29, sp
    mov w9, #12
    mov w10, #3
    cmp w9, w10
    cset w11, gt
    mov w0, w11
    ldp x29, x30, [sp], #16
    ret

@endtest

