@test("It should generate target arm64 code for unary negation")
@given("stdin")
int main(void) {
    return -10;
}
@whenRun("./bin/cclynx", args="--emit-asm /dev/stdin")
@expectOutput("stdout")
.text
.align 2

.global _main
_main:
    stp x29, x30, [sp, -16]!
    mov x29, sp
    mov w9, #10
    neg w10, w9
    mov w0, w10
    ldp x29, x30, [sp], #16
    ret

@endtest

@test("It should generate target arm64 code for unary negation in expression")
@given("stdin")
int main(void) {
    return -1 + 2;
}
@whenRun("./bin/cclynx", args="--emit-asm /dev/stdin")
@expectOutput("stdout")
.text
.align 2

.global _main
_main:
    stp x29, x30, [sp, -16]!
    mov x29, sp
    mov w9, #1
    neg w10, w9
    mov w9, #2
    add w11, w10, w9
    mov w0, w11
    ldp x29, x30, [sp], #16
    ret

@endtest

@test("It should generate target arm64 code for signed less than or equal (<=)")
