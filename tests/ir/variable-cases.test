@test("It should generate IR code when returning variable with a constant")
@given("stdin")
int main() {
    int x;
    x = 10;
    return x;
}
@whenRun("./bin/cclynx", args="--emit-ir /dev/stdin")
@expectOutput("stdout")
OP_FUNC "main"
OP_CONST 10, t0
OP_STORE x, t0
OP_LOAD x, t1
OP_RETURN t1
OP_FUNC_END

@endtest

@test("It should generate IR code when returning a variable with an expression")
@given("stdin")
int main() {
    int x;
    x = 7 * 8;
    return x / 2;
}
@whenRun("./bin/cclynx", args="--emit-ir /dev/stdin")
@expectOutput("stdout")
OP_FUNC "main"
OP_CONST 7, t0
OP_CONST 8, t1
OP_MUL t0, t1, t2
OP_STORE x, t2
OP_LOAD x, t3
OP_CONST 2, t4
OP_DIV t3, t4, t5
OP_RETURN t5
OP_FUNC_END

@endtest
