@test("It should generate IR code for if statement with constant false expression")
@given("stdin")
int main() {
    int i;
    i = 4;
    if (0) {
        i = 50;
    }
    return i;
}
@whenRun("./bin/cclynx", args="--emit-ir /dev/stdin")
@expectOutput("stdout")
OP_FUNC "main"
OP_CONST 4, t0
OP_STORE i, t0
OP_CONST 0, t1
OP_JUMP_IF_FALSE t1, ".L1"
OP_CONST 50, t2
OP_STORE i, t2
OP_LABEL ".L1"
OP_LOAD i, t3
OP_RETURN t3
OP_FUNC_END

@endtest

@test("It should generate IR code for if statement with constant true expression")
@given("stdin")
int main() {
    int i;
    i = 4;
    if (1) {
        i = 50;
    }
    return i;
}
@whenRun("./bin/cclynx", args="--emit-ir /dev/stdin")
@expectOutput("stdout")
OP_FUNC "main"
OP_CONST 4, t0
OP_STORE i, t0
OP_CONST 1, t1
OP_JUMP_IF_FALSE t1, ".L1"
OP_CONST 50, t2
OP_STORE i, t2
OP_LABEL ".L1"
OP_LOAD i, t3
OP_RETURN t3
OP_FUNC_END

@endtest

@test("It should generate IR code for if statement with empty expression statement")
@given("stdin")
int main() {
    if (0);
    return 0;
}
@whenRun("./bin/cclynx", args="--emit-ir /dev/stdin")
@expectOutput("stdout")
OP_FUNC "main"
OP_CONST 0, t0
OP_JUMP_IF_FALSE t0, ".L1"
OP_NOP
OP_LABEL ".L1"
OP_CONST 0, t1
OP_RETURN t1
OP_FUNC_END

@endtest

@test("It should generate IR code for if statement with empty compound statement")
@given("stdin")
int main() {
    if (0) {
    }
    return 0;
}
@whenRun("./bin/cclynx", args="--emit-ir /dev/stdin")
@expectOutput("stdout")
OP_FUNC "main"
OP_CONST 0, t0
OP_JUMP_IF_FALSE t0, ".L1"
OP_NOP
OP_LABEL ".L1"
OP_CONST 0, t1
OP_RETURN t1
OP_FUNC_END

@endtest

@test("It should generate IR code for if statement with relational expression <")
@given("stdin")
int main() {
    int i;
    i = 0;
    if (i < 10) {
        i = i + 1;
    }
    return i;
}
@whenRun("./bin/cclynx", args="--emit-ir /dev/stdin")
@expectOutput("stdout")
OP_FUNC "main"
OP_CONST 0, t0
OP_STORE i, t0
OP_LOAD i, t1
OP_CONST 10, t2
OP_JUMP_IF_GTE t1, t2, ".L1"
OP_LOAD i, t3
OP_CONST 1, t4
OP_ADD t3, t4, t5
OP_STORE i, t5
OP_LABEL ".L1"
OP_LOAD i, t6
OP_RETURN t6
OP_FUNC_END

@endtest

@test("It should generate IR code for if statement with relational expression >")
@given("stdin")
int main() {
    int i;
    i = 3;
    if (i > 1) {
        i = i - 1;
    }
    return i;
}
@whenRun("./bin/cclynx", args="--emit-ir /dev/stdin")
@expectOutput("stdout")
OP_FUNC "main"
OP_CONST 3, t0
OP_STORE i, t0
OP_LOAD i, t1
OP_CONST 1, t2
OP_JUMP_IF_LTE t1, t2, ".L1"
OP_LOAD i, t3
OP_CONST 1, t4
OP_SUB t3, t4, t5
OP_STORE i, t5
OP_LABEL ".L1"
OP_LOAD i, t6
OP_RETURN t6
OP_FUNC_END

@endtest

@test("It should generate IR code for if statement with equality expression ==")
@given("stdin")
int main() {
    int i;
    i = 0;
    if (i == 0) {
        i = i + 7;
    }
    return i;
}
@whenRun("./bin/cclynx", args="--emit-ir /dev/stdin")
@expectOutput("stdout")
OP_FUNC "main"
OP_CONST 0, t0
OP_STORE i, t0
OP_LOAD i, t1
OP_CONST 0, t2
OP_JUMP_IF_NE t1, t2, ".L1"
OP_LOAD i, t3
OP_CONST 7, t4
OP_ADD t3, t4, t5
OP_STORE i, t5
OP_LABEL ".L1"
OP_LOAD i, t6
OP_RETURN t6
OP_FUNC_END

@endtest

@test("It should generate IR code for if statement with equality expression !=")
@given("stdin")
int main() {
    int i;
    i = 10;
    if (i != 3) {
        i = i - 1;
    }
    return i;
}
@whenRun("./bin/cclynx", args="--emit-ir /dev/stdin")
@expectOutput("stdout")
OP_FUNC "main"
OP_CONST 10, t0
OP_STORE i, t0
OP_LOAD i, t1
OP_CONST 3, t2
OP_JUMP_IF_EQ t1, t2, ".L1"
OP_LOAD i, t3
OP_CONST 1, t4
OP_SUB t3, t4, t5
OP_STORE i, t5
OP_LABEL ".L1"
OP_LOAD i, t6
OP_RETURN t6
OP_FUNC_END

@endtest

@test("It should generate IR code for if statement with else statement")
@given("stdin")
int main() {
    int i;
    i = 10;
    if (0) {
        i = i - 1;
    } else {
        i = i * 15;
    }
    return i;
}
@whenRun("./bin/cclynx", args="--emit-ir /dev/stdin")
@expectOutput("stdout")
OP_FUNC "main"
OP_CONST 10, t0
OP_STORE i, t0
OP_CONST 0, t1
OP_JUMP_IF_FALSE t1, ".L1"
OP_LOAD i, t2
OP_CONST 1, t3
OP_SUB t2, t3, t4
OP_STORE i, t4
OP_JUMP ".L2"
OP_LABEL ".L1"
OP_LOAD i, t5
OP_CONST 15, t6
OP_MUL t5, t6, t7
OP_STORE i, t7
OP_LABEL ".L2"
OP_LOAD i, t8
OP_RETURN t8
OP_FUNC_END

@endtest

@test("It should generate IR code for if statement with empty compound statement for else")
@given("stdin")
int main() {
    int i;
    i = 10;
    if (0) {
        i = i - 1;
    } else {
    }
    return i;
}
@whenRun("./bin/cclynx", args="--emit-ir /dev/stdin")
@expectOutput("stdout")
OP_FUNC "main"
OP_CONST 10, t0
OP_STORE i, t0
OP_CONST 0, t1
OP_JUMP_IF_FALSE t1, ".L1"
OP_LOAD i, t2
OP_CONST 1, t3
OP_SUB t2, t3, t4
OP_STORE i, t4
OP_JUMP ".L2"
OP_LABEL ".L1"
OP_NOP
OP_LABEL ".L2"
OP_LOAD i, t5
OP_RETURN t5
OP_FUNC_END

@endtest

@test("It should generate IR code for if statement with empty expression statement for else")
@given("stdin")
int main() {
    int i;
    i = 10;
    if (0) {
        i = i - 1;
    } else
        ;
    return i;
}
@whenRun("./bin/cclynx", args="--emit-ir /dev/stdin")
@expectOutput("stdout")
OP_FUNC "main"
OP_CONST 10, t0
OP_STORE i, t0
OP_CONST 0, t1
OP_JUMP_IF_FALSE t1, ".L1"
OP_LOAD i, t2
OP_CONST 1, t3
OP_SUB t2, t3, t4
OP_STORE i, t4
OP_JUMP ".L2"
OP_LABEL ".L1"
OP_NOP
OP_LABEL ".L2"
OP_LOAD i, t5
OP_RETURN t5
OP_FUNC_END

@endtest

