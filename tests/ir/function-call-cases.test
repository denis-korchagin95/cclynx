@test("It should generate IR for function call without parameters")
@given("stdin")
int foo(void) {
   return 7;
}

int main() {
    return 42 * foo();
}
@whenRun("./bin/cclynx", args="--emit-ir /dev/stdin")
@expectOutput("stdout")
OP_FUNC "foo"
OP_CONST 7, t0
OP_RETURN t0
OP_FUNC_END

OP_FUNC "main"
OP_CONST 42, t0
OP_CALL "foo", t1
OP_MUL t0, t1, t2
OP_RETURN t2
OP_FUNC_END

@endtest

@test("It should generate IR for function call with 1 argument")
@given("stdin")
int identity(int a) {
    return a;
}

int main() {
    return identity(42);
}
@whenRun("./bin/cclynx", args="--emit-ir /dev/stdin")
@expectOutput("stdout")
OP_FUNC "identity"
OP_STORE_PARAM "a", 0
OP_LOAD a, t0
OP_RETURN t0
OP_FUNC_END

OP_FUNC "main"
OP_CONST 42, t0
OP_ARG t0, 0
OP_CALL "identity", t1
OP_RETURN t1
OP_FUNC_END

@endtest

@test("It should generate IR for function call with 2 arguments")
@given("stdin")
int add(int a, int b) {
    return a + b;
}

int main() {
    return add(19, 23);
}
@whenRun("./bin/cclynx", args="--emit-ir /dev/stdin")
@expectOutput("stdout")
OP_FUNC "add"
OP_STORE_PARAM "a", 0
OP_STORE_PARAM "b", 1
OP_LOAD a, t0
OP_LOAD b, t1
OP_ADD t0, t1, t2
OP_RETURN t2
OP_FUNC_END

OP_FUNC "main"
OP_CONST 19, t0
OP_ARG t0, 0
OP_CONST 23, t1
OP_ARG t1, 1
OP_CALL "add", t2
OP_RETURN t2
OP_FUNC_END

@endtest

@test("It should generate IR for function call with 3 arguments")
@given("stdin")
int foo(int a, int b, int c) {
    return a + b + c;
}

int main() {
    return foo(1, 2, 3);
}
@whenRun("./bin/cclynx", args="--emit-ir /dev/stdin")
@expectOutput("stdout")
OP_FUNC "foo"
OP_STORE_PARAM "a", 0
OP_STORE_PARAM "b", 1
OP_STORE_PARAM "c", 2
OP_LOAD a, t0
OP_LOAD b, t1
OP_ADD t0, t1, t2
OP_LOAD c, t3
OP_ADD t2, t3, t4
OP_RETURN t4
OP_FUNC_END

OP_FUNC "main"
OP_CONST 1, t0
OP_ARG t0, 0
OP_CONST 2, t1
OP_ARG t1, 1
OP_CONST 3, t2
OP_ARG t2, 2
OP_CALL "foo", t3
OP_RETURN t3
OP_FUNC_END

@endtest

@test("It should generate IR for function call with unspecified parameters")
@given("stdin")
int foo() {
   return 7;
}

int main() {
    return 42 * foo();
}
@whenRun("./bin/cclynx", args="--emit-ir /dev/stdin")
@expectOutput("stdout")
OP_FUNC "foo"
OP_CONST 7, t0
OP_RETURN t0
OP_FUNC_END

OP_FUNC "main"
OP_CONST 42, t0
OP_CALL "foo", t1
OP_MUL t0, t1, t2
OP_RETURN t2
OP_FUNC_END

@endtest
