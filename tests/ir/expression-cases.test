OP_RETURN t3
OP_FUNC_END

@endtest

@test("It should generate OP_NE for inequality")
@given("stdin")
int main() {
    return 12 != 3;
}
@whenRun("./bin/cclynx", args="--emit-ir /dev/stdin")
@expectOutput("stdout")
OP_FUNC "main"
OP_CONST 12, t1
