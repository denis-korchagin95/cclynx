@test("It should generate IR code for additive and multiplicative expression (+, *)")
@given("stdin")
int main() {
    return 2 * 3 + 1;
}
@whenRun("./bin/cclynx", args="--emit-ir /dev/stdin")
@expectOutput("stdout")
OP_FUNC "main"
OP_CONST 2, t0
OP_CONST 3, t1
OP_MUL t0, t1, t2
OP_CONST 1, t3
OP_ADD t2, t3, t4
OP_RETURN t4
OP_FUNC_END

@endtest

@test("It should generate IR code for nested sub-expressions")
@given("stdin")
int main() {
    return 2 * ((3 * 4 + 20) + 1) * 15;
}
@whenRun("./bin/cclynx", args="--emit-ir /dev/stdin")
@expectOutput("stdout")
OP_FUNC "main"
OP_CONST 2, t0
OP_CONST 3, t1
OP_CONST 4, t2
OP_MUL t1, t2, t3
OP_CONST 20, t4
OP_ADD t3, t4, t5
OP_CONST 1, t6
OP_ADD t5, t6, t7
OP_MUL t0, t7, t8
OP_CONST 15, t9
OP_MUL t8, t9, t10
OP_RETURN t10
OP_FUNC_END

@endtest

@test("It should generate IR code for subtraction and division (-, /)")
@given("stdin")
int main() {
    return 12 / 3 - 1;
}
@whenRun("./bin/cclynx", args="--emit-ir /dev/stdin")
@expectOutput("stdout")
OP_FUNC "main"
OP_CONST 12, t0
OP_CONST 3, t1
OP_DIV t0, t1, t2
OP_CONST 1, t3
OP_SUB t2, t3, t4
OP_RETURN t4
OP_FUNC_END

@endtest

@test("It should generate OP_GT for signed greater than")
@given("stdin")
int main() {
    return 12 > 3;
}
@whenRun("./bin/cclynx", args="--emit-ir /dev/stdin")
@expectOutput("stdout")
OP_FUNC "main"
OP_CONST 12, t0
OP_CONST 3, t1
OP_GT t0, t1, t2
OP_RETURN t2
OP_FUNC_END

@endtest

@test("It should generate OP_LT for signed less than")
@given("stdin")
int main() {
    return 12 < 3;
}
@whenRun("./bin/cclynx", args="--emit-ir /dev/stdin")
@expectOutput("stdout")
OP_FUNC "main"
OP_CONST 12, t0
OP_CONST 3, t1
OP_LT t0, t1, t2
OP_RETURN t2
OP_FUNC_END

@endtest

@test("It should generate OP_EQ for equality")
@given("stdin")
int main() {
    return 12 == 3;
}
@whenRun("./bin/cclynx", args="--emit-ir /dev/stdin")
@expectOutput("stdout")
OP_FUNC "main"
OP_CONST 12, t0
OP_CONST 3, t1
OP_EQ t0, t1, t2
OP_RETURN t2
OP_FUNC_END

@endtest

@test("It should generate OP_NE for inequality")
@given("stdin")
int main() {
    return 12 != 3;
}
@whenRun("./bin/cclynx", args="--emit-ir /dev/stdin")
@expectOutput("stdout")
OP_FUNC "main"
OP_CONST 12, t0
