OP_NE t0, t1, t2
OP_RETURN t2
OP_FUNC_END

@endtest

@test("It should generate OP_DIV for signed division")
@given("stdin")
int main() {
    return 10 / 3;
}
@whenRun("./bin/cclynx", args="--emit-ir /dev/stdin")
@expectOutput("stdout")
OP_FUNC "main"
OP_CONST 10, t0
OP_CONST 3, t1
OP_DIV t0, t1, t2
OP_RETURN t2
OP_FUNC_END

@endtest

@test("It should generate OP_DIV for unsigned division")
@given("stdin")
unsigned int main() {
    return 10u / 3u;
}
@whenRun("./bin/cclynx", args="--emit-ir --no-warnings /dev/stdin")
@expectOutput("stdout")
OP_FUNC "main"
OP_CONST 10, t0
OP_CONST 3, t1
OP_DIV t0, t1, t2
OP_RETURN t2
OP_FUNC_END

@endtest

@test("It should generate OP_MOD for signed modulo")
@given("stdin")
int main() {
    return 10 % 3;
}
@whenRun("./bin/cclynx", args="--emit-ir /dev/stdin")
@expectOutput("stdout")
OP_FUNC "main"
OP_CONST 10, t0
OP_CONST 3, t1
OP_MOD t0, t1, t2
OP_RETURN t2
OP_FUNC_END

@endtest

@test("It should generate OP_MOD for unsigned modulo")
@given("stdin")
unsigned int main() {
    return 10u % 3u;
}
@whenRun("./bin/cclynx", args="--emit-ir --no-warnings /dev/stdin")
@expectOutput("stdout")
OP_FUNC "main"
OP_CONST 10, t0
OP_CONST 3, t1
OP_MOD t0, t1, t2
OP_RETURN t2
OP_FUNC_END

@endtest

@test("It should generate OP_LT for unsigned less than")
@given("stdin")
int main() {
    return 3u < 5u;
}
@whenRun("./bin/cclynx", args="--emit-ir --no-warnings /dev/stdin")
@expectOutput("stdout")
OP_FUNC "main"
OP_CONST 3, t0
OP_CONST 5, t1
OP_LT t0, t1, t2
OP_RETURN t2
OP_FUNC_END

@endtest

@test("It should generate OP_GT for unsigned greater than")
@given("stdin")
int main() {
    return 5u > 3u;
}
@whenRun("./bin/cclynx", args="--emit-ir --no-warnings /dev/stdin")
@expectOutput("stdout")
OP_FUNC "main"
OP_CONST 5, t0
OP_CONST 3, t1
OP_GT t0, t1, t2
OP_RETURN t2
OP_FUNC_END

@endtest

@test("It should generate IR code for unary negation")
@given("stdin")
int main(void) {
    return -10;
}
@whenRun("./bin/cclynx", args="--emit-ir /dev/stdin")
@expectOutput("stdout")
OP_FUNC "main"
OP_CONST 10, t0
OP_NEG t0, t1
OP_RETURN t1
OP_FUNC_END

@endtest

@test("It should generate IR code for unary negation in expression")
@given("stdin")
int main(void) {
    return -1 + 2;
}
@whenRun("./bin/cclynx", args="--emit-ir /dev/stdin")
@expectOutput("stdout")
OP_FUNC "main"
OP_CONST 1, t0
OP_NEG t0, t1
OP_CONST 2, t2
OP_ADD t1, t2, t3
OP_RETURN t3
OP_FUNC_END

@endtest

@test("It should generate IR code for an unary logical not")
@given("stdin")
int main(void) {
    return !0;
}
@whenRun("./bin/cclynx", args="--emit-ir /dev/stdin")
@expectOutput("stdout")
OP_FUNC "main"
OP_CONST 0, t0
OP_LOGICAL_NOT t0, t1
OP_RETURN t1
OP_FUNC_END

@endtest

@test("It should generate IR code for a double unary logical not")
@given("stdin")
int main(void) {
    return !!5;
}
@whenRun("./bin/cclynx", args="--emit-ir /dev/stdin")
@expectOutput("stdout")
OP_FUNC "main"
OP_CONST 5, t0
OP_LOGICAL_NOT t0, t1
OP_LOGICAL_NOT t1, t2
OP_RETURN t2
OP_FUNC_END

@endtest
